[Unit]
Description=Uvicorn Server for Fast API Python Application
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/home/exch/asteriskGUI
ExecStart=/home/exch/asteriskGUI/pyasterisk/bin/python3 -m uvicorn main:app --reload --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
